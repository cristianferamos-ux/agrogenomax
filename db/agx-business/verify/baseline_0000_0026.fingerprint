constraint|agx.animal_eventos|animal_eventos_animal_organizacion_fkey|f|validated=true|FOREIGN KEY (animal_id, organizacion_id) REFERENCES agx.animales(animal_id, organizacion_id)
constraint|agx.animal_eventos|animal_eventos_metadata_check|c|validated=true|CHECK ((jsonb_typeof(metadata_json) = 'object'::text))
constraint|agx.animal_eventos|animal_eventos_pkey|p|validated=true|PRIMARY KEY (evento_id)
constraint|agx.animal_eventos|animal_eventos_tipo_check|c|validated=true|CHECK (((tipo_evento)::text = ANY ((ARRAY['REGISTRADO'::character varying, 'DATOS_CORREGIDOS'::character varying, 'ANULADO'::character varying, 'QR_ASOCIADO'::character varying, 'QR_REVOCADO'::character varying, 'QR_REEMPLAZADO'::character varying, 'SALIDO'::character varying, 'MUERTO'::character varying])::text[])))
constraint|agx.animal_pesajes|animal_pesajes_animal_organizacion_fkey|f|validated=true|FOREIGN KEY (animal_id, organizacion_id) REFERENCES agx.animales(animal_id, organizacion_id)
constraint|agx.animal_pesajes|animal_pesajes_fecha_min_check|c|validated=true|CHECK ((fecha >= '1990-01-01'::date))
constraint|agx.animal_pesajes|animal_pesajes_manual_client_operation_check|c|validated=true|CHECK ((((origen)::text <> 'MANUAL'::text) OR (client_operation_id IS NOT NULL)))
constraint|agx.animal_pesajes|animal_pesajes_metodo_check|c|validated=true|CHECK (((metodo)::text = ANY ((ARRAY['BASCULA'::character varying, 'ESTIMADO'::character varying])::text[])))
constraint|agx.animal_pesajes|animal_pesajes_observaciones_check|c|validated=true|CHECK (((observaciones IS NULL) OR ((btrim(observaciones) <> ''::text) AND (char_length(observaciones) <= 500))))
constraint|agx.animal_pesajes|animal_pesajes_origen_check|c|validated=true|CHECK (((origen)::text = ANY ((ARRAY['REGISTRO_INICIAL'::character varying, 'MANUAL'::character varying])::text[])))
constraint|agx.animal_pesajes|animal_pesajes_peso_check|c|validated=true|CHECK (((peso_kg > (0)::numeric) AND (peso_kg <= (2000)::numeric) AND (peso_kg = round(peso_kg, 1))))
constraint|agx.animal_pesajes|animal_pesajes_pkey|p|validated=true|PRIMARY KEY (pesaje_id)
constraint|agx.animales|animales_categoria_productiva_fkey|f|validated=true|FOREIGN KEY (categoria_productiva_id) REFERENCES agx.catalogo_categorias_productivas(categoria_id)
constraint|agx.animales|animales_cierre_consistency_check|c|validated=true|CHECK (((((estado_operativo)::text = 'EN_HATO'::text) AND (cierre_fecha IS NULL) AND (cierre_causa IS NULL) AND (cierre_observaciones IS NULL) AND (cierre_at IS NULL) AND (cierre_por IS NULL) AND (cierre_client_operation_id IS NULL)) OR (((estado_operativo)::text = 'SALIDO'::text) AND (cierre_fecha IS NOT NULL) AND (cierre_at IS NOT NULL) AND (cierre_por IS NOT NULL) AND (cierre_client_operation_id IS NOT NULL) AND ((cierre_causa)::text = ANY ((ARRAY['VENTA'::character varying, 'TRASLADO'::character varying, 'DONACION'::character varying, 'INTERCAMBIO'::character varying, 'DEVOLUCION'::character varying, 'OTRA'::character varying])::text[]))) OR (((estado_operativo)::text = 'MUERTO'::text) AND (cierre_fecha IS NOT NULL) AND (cierre_at IS NOT NULL) AND (cierre_por IS NOT NULL) AND (cierre_client_operation_id IS NOT NULL) AND ((cierre_causa)::text = ANY ((ARRAY['MUERTE_NATURAL'::character varying, 'ENFERMEDAD'::character varying, 'ACCIDENTE'::character varying, 'SACRIFICIO'::character varying, 'DEPREDACION'::character varying, 'DESCONOCIDA'::character varying, 'OTRA'::character varying])::text[])))))
constraint|agx.animales|animales_cierre_fecha_min_check|c|validated=true|CHECK (((cierre_fecha IS NULL) OR (cierre_fecha >= '1990-01-01'::date)))
constraint|agx.animales|animales_cierre_fecha_orden_check|c|validated=true|CHECK (((cierre_fecha IS NULL) OR (((fecha_nacimiento IS NULL) OR (cierre_fecha >= fecha_nacimiento)) AND ((fecha_ingreso IS NULL) OR (cierre_fecha >= fecha_ingreso)))))
constraint|agx.animales|animales_cierre_observaciones_check|c|validated=true|CHECK (((cierre_observaciones IS NULL) OR ((btrim(cierre_observaciones) <> ''::text) AND (char_length(cierre_observaciones) <= 500))))
constraint|agx.animales|animales_creation_intent_hash_check|c|validated=true|CHECK (((creation_intent_hash)::text ~ '^v1:[0-9a-f]{64}$'::text))
constraint|agx.animales|animales_cruce_descripcion_formato_check|c|validated=true|CHECK (((cruce_descripcion IS NULL) OR (((cruce_descripcion)::text <> ''::text) AND ((cruce_descripcion)::text = btrim(regexp_replace((cruce_descripcion)::text, '\s+'::text, ' '::text, 'g'::text))))))
constraint|agx.animales|animales_edad_aproximada_check|c|validated=true|CHECK (((edad_aproximada_meses IS NULL) OR ((edad_aproximada_meses >= 0) AND (edad_aproximada_meses <= 300))))
constraint|agx.animales|animales_estado_check|c|validated=true|CHECK (((estado)::text = ANY ((ARRAY['ACTIVO'::character varying, 'ANULADO'::character varying])::text[])))
