    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "framer-motion": "^12.0.0",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "opentype.js": "1.3.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
