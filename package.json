ts__/potreroFichaVigenciaResolverIntegration.test.js\" \"server/services/__tests__/potreroCargaAutomaticaRepositoryIntegration.test.js\"",
    "test:test-runners": "node --test .tools/__tests__/*.test.mjs"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@vitejs/plugin-react": "^5.0.0",
