{
  "name": "agrogenomax-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node server/index.js",
    "build": "node .tools/check-encoding.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "catastrox:regression": "node scripts/catastrox/regression/validate-v7-regression.mjs",
    "catastrox:regression:local": "powershell -ExecutionPolicy Bypass -File scripts/catastrox/regression/run-v7-regression.ps1",
    "test:catastrox-semantic": "node src/modules/catastrox/semantic/tests/runSemanticTests.mjs",
    "test:catastrox-geometry": "node src/modules/catastrox/utils/tests/runGeometryTests.mjs",
    "catastrox:real-predio": "node scripts/catastrox/real-world/validate-real-predio.mjs",
    "test:node": "node .tools/run-node-tests.mjs",
    "test:all": "npm run test:test-runners && npm run test:node && npm run test:catastrox-semantic && npm run test:catastrox-geometry",
    "test": "npm run test:all",
