# Ambiente funcional del backend (ADR-014 §13). Valores permitidos:
# development | test | demo | staging | production.
# NODE_ENV no sustituye esta variable. Debe declararse explícitamente:
# el backend (server/index.js) no arranca sin ella -- no existe
# inferencia automática por hostname ni por ningún otro heurístico
# implícito (ver server/config/env.js).
APP_ENV=development

# Ambiente funcional del FRONTEND (ADR-014 §13, LOTE-003). Valores
# permitidos: development | test | demo | staging | production. Variable
# de build de Vite (VITE_*), separada de APP_ENV del backend porque cada
# una se resuelve en un runtime distinto. NODE_ENV no la sustituye. El
# override de URL de API (agx_api_url/apiUrl, por query string o
# localStorage) SOLO tiene efecto cuando VITE_APP_ENV=development y el
# hostname del navegador es exactamente localhost/127.0.0.1 -- en
# cualquier otro caso se ignora, se limpia y se reporta (ver
# src/config/runtimeConfig.js). Ausencia de esta variable en un hostname
# desplegado nunca se infiere como production.
VITE_APP_ENV=development
VITE_MAPBOX_TOKEN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGX_PUBLIC_APP_URL=https://agrogenomax.com
VITE_AGX_API_URL=http://127.0.0.1:3001/api
CATASTROX_DATABASE_URL=postgres://postgres:REEMPLAZAR@localhost:5432/CATASTROX_POSTGIS
CATASTROX_PGSCHEMA=catastrox
CATASTROX_AUDIT_DOWNLOADS=false
CATASTROX_ADVANCED_LOOKUP_ENABLED=false
VITE_CATASTROX_AUDIT_DOWNLOADS=false
WOMPI_ENV=test
WOMPI_PUBLIC_KEY_TEST=pub_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET_TEST=test_integrity_REEMPLAZAR
# Secreto de eventos de Wompi (distinto del de integridad) -- ver
# server/.env.example para el detalle de formato y uso.
WOMPI_EVENTS_SECRET_TEST=events_secret_REEMPLAZAR
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
CATASTROX_FRONTEND_URL=http://127.0.0.1:5173
# TRUST_PROXY_HOPS=0
# CATASTROX_DATASET_VERSION=2026-01
# Modelo de comprador -- ver server/.env.example para el detalle de formato.
CATASTROX_PII_ENCRYPTION_KEY=REEMPLAZAR_32_BYTES_BASE64
CATASTROX_PII_HASH_SECRET=pii_hash_secret_REEMPLAZAR_treinta_dos_caracteres

# --- Relay de Cloudflare Pages Functions (LOTE-004, ADR-014 §7 Barrera 4/
# §21) -- functions/api/catastrox/[[path]].js y su gemela de pagos, más
# functions/api/ganaderia/[[path]].js (BFF-001, relay dedicado y aislado
# de sesión segura de Ganadería -- mismo backend Express, por eso
# reutiliza el mismo API_BACKEND_URL de abajo, sin variable nueva). Estas
# variables NO se leen de este archivo (dotenv no las carga): se
# configuran directamente en el panel de Cloudflare Pages del proyecto, por
# ambiente. Se documentan aquí únicamente como referencia.
# APP_ENV: obligatoria en el relay; sin ella responde 503 (nunca infiere
#   ni cae a otro ambiente). En demo el relay no existe funcionalmente
#   (responde 404/410 sin importar configuración).
# API_BACKEND_URL: origen puro (http/https, sin credenciales, sin path,
#   sin query, sin fragment) del backend real. Obligatoria en staging y
#   production; sin ella o inválida, el relay responde 503 sin intentar
#   conectarse a ningún backend (nunca cae a Railway ni a ninguna URL por
#   defecto).
# CORS_ALLOWED_ORIGINS (opcional, CSV): amplía -- nunca sustituye -- la
#   allowlist obligatoria de CORS del relay para ese ambiente. AgroGenomaX
#   tiene dos dominios oficiales de producción, ambos obligatorios por
#   defecto sin necesidad de esta variable: https://agrogenomax.com y
#   https://agrogenomax.co. En production, esta variable ÚNICAMENTE puede
#   contener https://www.agrogenomax.com y/o https://www.agrogenomax.co --
#   cualquier otro valor (otro subdominio, dominio externo, Railway,
#   preview de Cloudflare Pages, staging, demo, localhost) falla-rápido
#   (el relay responde 503). Prohibida de facto en demo (el relay ya
#   responde 404/410 antes de leerla).
