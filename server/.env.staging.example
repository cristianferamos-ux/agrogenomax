# =============================================================================
# LOTE-015 — Matriz documental de variables de entorno para STAGING
# Plan Maestro / ADR-014 §13
# =============================================================================
#
# ESTE ARCHIVO NO ES DESPLEGABLE.
# No es una fuente única cargable con `dotenv` ni un .env real.
# Es una MATRIZ DOCUMENTAL organizada por plano de ejecución, que describe
# QUÉ variables existen, DÓNDE se consumen (backend, build frontend, relay
# Cloudflare) y DE DÓNDE debe salir su valor real en Fase 4 (AWS Secrets
# Manager). Ningún valor aquí es un secreto real, host real, ARN, ID de
# Cognito, cuenta AWS o credencial. Todos los placeholders de secreto están
# escritos en formato <SECRET_MANAGER:...> y son obviamente no desplegables.
#
# Los secretos del backend se inyectarán en Fase 4 en el entorno de
# ejecución de ECS (ECS task definition) directamente desde AWS Secrets
# Manager. Las variables VITE_* se configuran, por separado, en el entorno
# de build de Cloudflare Pages — no provienen de Secrets Manager. Las
# variables del relay se configuran en el entorno de Cloudflare Pages
# Functions. AWS Secrets Manager NO inyecta variables directamente en
# Cloudflare. Jamás se confirman en Git.
#
# No se afirma que Secrets Manager, Cognito, ALB, ECS, RDS, Cloudflare
# staging o Terraform ya existan: este archivo solo documenta el contrato
# de configuración objetivo.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BACKEND — Express / ECS
# Variables leídas HOY por el código del backend (server/).
# -----------------------------------------------------------------------------

# Entorno lógico de la aplicación. Es el valor que el código evalúa
# realmente para activar comportamiento de staging.
APP_ENV=staging

# NODE_ENV es INFORMATIVA para herramientas de Node/npm (optimizaciones de
# librerías, etc.). NO sustituye a APP_ENV y el código no debe depender de
# NODE_ENV para decidir comportamiento de staging vs producción.
NODE_ENV=production

# Puerto de escucha del proceso Express dentro del contenedor ECS.
PORT=3000

# Cadena de conexión a la base de datos principal (agx).
# SECRETO. Placeholder inequívoco — el valor real vive en Secrets Manager
# bajo el nombre agx/staging/database-url y se inyecta en runtime.
DATABASE_URL=<SECRET_MANAGER:agx/staging/database-url>

# Esquema de PostgreSQL usado por la base de datos principal.
PGSCHEMA=agx

# Cadena de conexión a la base de datos PostGIS de CatastroX.
# SECRETO. Placeholder inequívoco — el valor real vive en Secrets Manager
# bajo el nombre postgis-catastrox/staging/database-url y se inyecta en runtime.
CATASTROX_DATABASE_URL=<SECRET_MANAGER:postgis-catastrox/staging/database-url>

# Esquema de PostgreSQL usado por CatastroX.
CATASTROX_PGSCHEMA=catastrox

# Token de autenticación para el endpoint de monitoreo de salud.
# SECRETO, OBLIGATORIO. Debe tener un mínimo de 32 caracteres, sin espacios
# al inicio ni al final. Placeholder inequívoco — el valor real vive en
# Secrets Manager y se inyecta en runtime.
HEALTH_MONITOR_TOKEN=<SECRET_MANAGER:agx/staging/health-monitor-token>

# R3/B6-26 + B6-26-ADJ-01 (identityCapability.js): tokens de identidad del
# flujo de comprador de CatastroX. Dos claves AES-256-GCM INDEPENDIENTES
# entre sí y de CATASTROX_PII_ENCRYPTION_KEY -- nunca reutilizar una para
# la otra. SECRETO, OBLIGATORIO. Cada una debe decodificar a exactamente
# 32 bytes en base64 estándar. Placeholders inequívocos — los valores
# reales viven en Secrets Manager y se inyectan en runtime.
CATASTROX_VERIFY_HANDLE_KEY=<SECRET_MANAGER:agx/staging/catastrox-verify-handle-key>
CATASTROX_CHECKOUT_IDENTITY_KEY=<SECRET_MANAGER:agx/staging/catastrox-checkout-identity-key>

# Tiempo máximo (ms) de espera en apagado ordenado del proceso.
# Valor inicial/default sujeto a calibración operativa. Rango válido: 2000-120000.
SHUTDOWN_TIMEOUT_MS=15000

# OPCIONAL. Orígenes CORS adicionales separados por coma.
# https://staging.agrogenomax.com ya es un origen obligatorio incorporado
# por código y NO necesita repetirse aquí. Solo definir si se requiere un
# origen adicional distinto al de staging.
# CORS_ALLOWED_ORIGINS=

# Flags de CatastroX (funcionalidad restringida en staging).
CATASTROX_AUDIT_DOWNLOADS=false
CATASTROX_ADVANCED_LOOKUP_ENABLED=false
CATASTROX_RESOLVER_SHADOW_ENABLED=false

# Wompi — pasarela de pagos. En staging SOLO entorno de pruebas (sandbox).
WOMPI_ENV=test

# Llave pública de Wompi (test). SECRETO/valor sensible de configuración.
# Placeholder inequívoco — el valor real vive en Secrets Manager.
WOMPI_PUBLIC_KEY_TEST=<SECRET_MANAGER:agx/staging/wompi-public-key-test>

# Secreto de integridad de Wompi (test). SECRETO.
# Placeholder inequívoco — el valor real vive en Secrets Manager.
WOMPI_INTEGRITY_SECRET_TEST=<SECRET_MANAGER:agx/staging/wompi-integrity-secret-test>

# URL base de la API sandbox de Wompi. No es secreto, es un endpoint público
# documentado por el proveedor.
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

# URL pública del frontend usada por el backend para construir enlaces
# (por ejemplo, en flujos de CatastroX).
CATASTROX_FRONTEND_URL=https://staging.agrogenomax.com


# -----------------------------------------------------------------------------
# 2. FRONTEND — Vite / Cloudflare Pages build
# Estas variables NO las lee el backend ni este archivo en runtime del
# backend: son inyectadas en tiempo de BUILD del frontend (Cloudflare Pages
# build environment) y quedan embebidas en el bundle estático resultante.
# -----------------------------------------------------------------------------

VITE_APP_ENV=staging
VITE_AGX_PUBLIC_APP_URL=https://staging.agrogenomax.com
VITE_AGX_API_URL=https://staging.agrogenomax.com/api
VITE_API_URL=https://staging.agrogenomax.com/api
VITE_CATASTROX_AUDIT_DOWNLOADS=false

# ADVERTENCIA: cualquier variable VITE_* queda EXPUESTA en texto plano
# dentro del bundle JavaScript servido al navegador. NUNCA puede contener
# un secreto real. El valor siguiente debe ser un token público de Mapbox
# restringido (por dominio/URL) al entorno de staging.
# Placeholder inequívoco — el valor real se configura como variable de
# build en Cloudflare Pages, NO en AWS Secrets Manager. No es un secreto
# de servidor.
VITE_MAPBOX_TOKEN=<CLOUDFLARE_BUILD:MAPBOX_PUBLIC_TOKEN_RESTRICTED>

# Configuración heredada/condicional de Supabase.
# Dejar VACÍAS en staging. Antes de habilitarlas, validar explícitamente
# si Supabase sigue siendo necesario en este entorno. Si llegan a
# habilitarse, VITE_SUPABASE_ANON_KEY debe ser la llave pública "anon";
# NUNCA una service-role key (esa sí es secreta y nunca debe ir en VITE_*).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# 3. RELAY — Cloudflare Pages Functions
# Estas variables pertenecen al entorno de ejecución de Cloudflare (Pages
# Functions), no al backend Express ni al build del frontend.
# -----------------------------------------------------------------------------

APP_ENV=staging

# NO es secreto: es configuración del entorno de ejecución de Cloudflare
# Pages Functions (relay), no un valor de AWS Secrets Manager.
# Origen HTTPS puro del backend de staging (protocolo + host, sin path,
# sin query string, sin fragmento y SIN credenciales embebidas).
# Placeholder inequívoco — no se afirma que este origen ya exista.
API_BACKEND_URL=<CLOUDFLARE_PAGES:STAGING_BACKEND_ORIGIN>

# OPCIONAL y normalmente AUSENTE. Solo definir si el relay necesita
# permitir orígenes CORS adicionales a los ya incorporados por código.
# CORS_ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# 4. CONFIGURACIÓN OBJETIVO FUTURA — aún NO consumida por el código
# NO HABILITAR hasta implementar Cognito/BFF (ADR-014). Documentado aquí
# únicamente como contrato futuro; su presencia no activa nada hoy.
# -----------------------------------------------------------------------------

# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# ADR-014 §16 exige cookies host-only (sin atributo Domain). Por lo tanto
# COOKIE_DOMAIN debe permanecer VACÍO: emitir el atributo Domain rompería
# el requisito de cookie host-only. No asignar un valor "de ejemplo".
# COOKIE_DOMAIN=

# Nombres de cookies de sesión/autenticación: NO se documentan aquí porque
# los nombres contractuales todavía no están cerrados por ADR. No inventar
# nombres; agregar solo cuando ADR-014 los defina explícitamente.


# -----------------------------------------------------------------------------
# 5. VARIABLES EXCLUIDAS O PROHIBIDAS EN STAGING
# -----------------------------------------------------------------------------

# CORS_ORIGIN — OBSOLETA. No usar. Usar CORS_ALLOWED_ORIGINS si es
# estrictamente necesario (ver secciones 1 y 3).

# TEST_USE_REAL_SERVICES — EXCLUSIVA de APP_ENV=test. No usar en staging.

# PROHIBIDO en staging:
#   WOMPI_ENV=production
#   Cualquier variable WOMPI_*_PROD (ej. WOMPI_PUBLIC_KEY_PROD,
#   WOMPI_INTEGRITY_SECRET_PROD, WOMPI_PRIVATE_KEY_PROD).

# PROHIBIDO en cualquier variable de este archivo:
#   - URLs de demo, producción, Railway o localhost.
#   - Overrides de agx_api_url / ?apiUrl fuera de development local.

# PROHIBIDO en general:
#   - Cualquier secreto real, host real de base de datos, contraseña,
#     token, ARN, ID real de Cognito, cuenta AWS o credencial confirmada
#     en Git.
