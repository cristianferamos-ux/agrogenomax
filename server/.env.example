# Ambiente funcional (ADR-014 §13). Valores permitidos:
# development | test | demo | staging | production.
# Debe declararse explícitamente: el backend no arranca sin ella -- no
# existe inferencia automática por hostname ni por ningún otro
# heurístico implícito. NODE_ENV nunca la sustituye.
APP_ENV=development
PORT=3001
# SHUTDOWN_TIMEOUT_MS (opcional, LOTE-007, ADR-012 §21): límite temporal
# global del graceful shutdown (SIGTERM/SIGINT) en milisegundos. Debe ser
# un entero entre 2000 y 120000; cualquier valor ausente, no entero o
# fuera de rango usa el default seguro (15000 = 15s), sin lanzar ni
# impedir el arranque. No forma parte de la validación central de
# APP_ENV (server/config/env.js).
# SHUTDOWN_TIMEOUT_MS=15000
DATABASE_URL=postgres://postgres:REEMPLAZAR@localhost:5432/AGROGENOMAX
PGSCHEMA=agx
CATASTROX_DATABASE_URL=postgres://postgres:REEMPLAZAR@localhost:5432/CATASTROX_POSTGIS
CATASTROX_PGSCHEMA=catastrox
# CORS_ORIGIN quedó reemplazada por la allowlist de CORS derivada de
# APP_ENV (LOTE-004, ADR-014 §7 Barrera 4 -- server/config/env.js,
# server/security/corsPolicy.js). Ya no tiene efecto en server/index.js;
# se conserva comentada solo como referencia histórica.
# CORS_ORIGIN=http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS (opcional, CSV): amplía -- nunca sustituye -- la
# allowlist obligatoria por ambiente. AgroGenomaX tiene dos dominios
# oficiales de producción: https://agrogenomax.com y https://agrogenomax.co
# (ambos obligatorios por defecto, sin necesidad de esta variable).
# - development: solo localhost/127.0.0.1 explícitos.
# - staging: solo un origen técnico adicional de staging válido.
# - production: ÚNICAMENTE https://www.agrogenomax.com y/o
#   https://www.agrogenomax.co -- cualquier otro valor (otro subdominio de
#   agrogenomax.com/agrogenomax.co, dominio externo, Railway, preview de
#   Cloudflare Pages, staging, demo, localhost) falla-rápido.
# Prohibida en demo (demo no tiene backend). Cada origen debe ser http(s),
# sin credenciales, path, query ni fragment.
# CORS_ALLOWED_ORIGINS=
WOMPI_ENV=test
WOMPI_PUBLIC_KEY_TEST=pub_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET_TEST=test_integrity_REEMPLAZAR
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
CATASTROX_FRONTEND_URL=http://127.0.0.1:5173
