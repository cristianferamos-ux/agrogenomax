# Ambiente funcional (ADR-014 §13). Valores permitidos:
# development | test | demo | staging | production.
# Debe declararse explícitamente: el backend no arranca sin ella -- no
# existe inferencia automática por hostname ni por ningún otro
# heurístico implícito. NODE_ENV nunca la sustituye.
APP_ENV=development
PORT=3001
# SHUTDOWN_TIMEOUT_MS (opcional, LOTE-007, ADR-012 §21): límite temporal
# global del graceful shutdown (SIGTERM/SIGINT) en milisegundos. Debe ser
# un entero entre 2000 y 120000; cualquier valor ausente, no entero o
# fuera de rango usa el default seguro (15000 = 15s), sin lanzar ni
# impedir el arranque. No forma parte de la validación central de
# APP_ENV (server/config/env.js).
# SHUTDOWN_TIMEOUT_MS=15000
DATABASE_URL=postgres://postgres:REEMPLAZAR@localhost:5432/AGROGENOMAX
PGSCHEMA=agx
CATASTROX_DATABASE_URL=postgres://postgres:REEMPLAZAR@localhost:5432/CATASTROX_POSTGIS
CATASTROX_PGSCHEMA=catastrox
# CORS_ORIGIN quedó reemplazada por la allowlist de CORS derivada de
# APP_ENV (LOTE-004, ADR-014 §7 Barrera 4 -- server/config/env.js,
# server/security/corsPolicy.js). Ya no tiene efecto en server/index.js;
# se conserva comentada solo como referencia histórica.
# CORS_ORIGIN=http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS (opcional, CSV): amplía -- nunca sustituye -- la
# allowlist obligatoria por ambiente. AgroGenomaX tiene dos dominios
# oficiales de producción: https://agrogenomax.com y https://agrogenomax.co
# (ambos obligatorios por defecto, sin necesidad de esta variable).
# - development: solo localhost/127.0.0.1 explícitos.
# - staging: solo un origen técnico adicional de staging válido.
# - production: ÚNICAMENTE https://www.agrogenomax.com y/o
#   https://www.agrogenomax.co -- cualquier otro valor (otro subdominio de
#   agrogenomax.com/agrogenomax.co, dominio externo, Railway, preview de
#   Cloudflare Pages, staging, demo, localhost) falla-rápido.
# Prohibida en demo (demo no tiene backend). Cada origen debe ser http(s),
# sin credenciales, path, query ni fragment.
# CORS_ALLOWED_ORIGINS=
WOMPI_ENV=test
WOMPI_PUBLIC_KEY_TEST=pub_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET_TEST=test_integrity_REEMPLAZAR
# WOMPI_EVENTS_SECRET_TEST (opcional por ahora, recomendado): secreto de
# eventos de Wompi Sandbox -- DISTINTO de WOMPI_INTEGRITY_SECRET_TEST,
# disponible en "Secretos para integración técnica" del dashboard de Wompi.
# Autentica POST /api/catastrox/payments/wompi/events (webhook). Mínimo 32
# caracteres, sin espacios iniciales/finales, si está presente. En
# producción existirá un WOMPI_EVENTS_SECRET_PRODUCTION independiente (aún
# no usado por este backend -- pendiente de activar junto con WOMPI_ENV=
# production).
WOMPI_EVENTS_SECRET_TEST=events_secret_REEMPLAZAR
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
CATASTROX_FRONTEND_URL=http://127.0.0.1:5173
# TRUST_PROXY_HOPS (opcional, entero 0-5, default 0): número exacto de
# saltos de reverse proxy confiables (p. ej. Cloudflare + ALB) delante de
# este backend, usado únicamente por el rate limiting de
# server/middleware/rateLimit.js para resolver la IP real del cliente desde
# X-Forwarded-For. 0 = nunca confiar en X-Forwarded-For (usa el socket TCP
# real). Configurar con el valor exacto de la topología de red real --
# nunca "a ojo" -- un valor mayor al real permite falsificar la IP vista por
# el rate limiter.
# TRUST_PROXY_HOPS=0
# Modelo de comprador (migración 004) -- cifrado/hashing de PII en
# server/services/catastrox/piiCrypto.js. Obligatorias en staging/production
# (server/config/env.js). CATASTROX_PII_ENCRYPTION_KEY debe decodificar a
# exactamente 32 bytes en base64 (AES-256-GCM): generar con
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# CATASTROX_PII_HASH_SECRET (>=32 caracteres, distinto de cualquier otro
# secreto de este archivo) autentica document_number_hash vía HMAC-SHA256 --
# nunca un hash simple del documento, que sería enumerable.
CATASTROX_PII_ENCRYPTION_KEY=REEMPLAZAR_32_BYTES_BASE64
CATASTROX_PII_HASH_SECRET=pii_hash_secret_REEMPLAZAR_treinta_dos_caracteres
# CATASTROX_DATASET_VERSION (opcional, default '2026-01'): etiqueta estática
# del dataset catastral servido -- se usa únicamente para construir el
# identificador canónico de respaldo de predios SIN código predial conocido
# (fuente:version:idDeFila). No existe un versionado real por importación
# hoy; esta variable documenta esa aproximación en vez de ocultarla.
# CATASTROX_DATASET_VERSION=2026-01
# CATASTROX_BACKFILL_TRANSACTION_ID: SOLO para
# scripts/catastrox/backfill-known-approved-order.mjs (herramienta
# administrativa local, nunca se ejecuta en el backend real ni en CI) --
# identificador de la transacción Sandbox de Wompi que ese script debe
# respaldar. Obligatoria para esa única ejecución manual; el script nunca
# trae un transactionId real codificado ni un valor por defecto. No dejar
# un valor real aquí ni en ningún archivo versionado.
# CATASTROX_BACKFILL_TRANSACTION_ID=REEMPLAZAR
